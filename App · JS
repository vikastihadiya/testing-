/* ---------------------------------------------------------------------
   Services
--------------------------------------------------------------------- */
let activeSvcCat = "ALL";
function renderServiceFilters(){
  const wrap = document.getElementById("svcFilters");
  const cats = ["ALL", ...CATEGORIES.map(c=>c.name)];
  wrap.innerHTML = cats.map(c=>`<button class="chip ${c===activeSvcCat?'active':''}" data-cat="${esc(c)}">${esc(c)}</button>`).join("");
  wrap.querySelectorAll(".chip").forEach(b=> b.addEventListener("click", ()=>{ activeSvcCat=b.dataset.cat; renderServiceFilters(); renderServices(); }));
}
function renderServices(){
  const grid = document.getElementById("svcGrid");
  const q = (document.getElementById("svcSearch").value || "").toLowerCase();
  const sort = document.getElementById("svcSort").value;

  let list = SERVICES.filter(s=>{
    const cName = categoryName(s.category_id);
    const matchCat = activeSvcCat === "ALL" || cName === activeSvcCat;
    const matchQ = !q || s.name.toLowerCase().includes(q) || (s.description||"").toLowerCase().includes(q);
    return matchCat && matchQ;
  });
  if(sort==="low") list = [...list].sort((a,b)=>(a.price ?? 1e9) - (b.price ?? 1e9));
  if(sort==="high") list = [...list].sort((a,b)=>(b.price ?? -1) - (a.price ?? -1));
  if(sort==="popular") list = [...list].sort((a,b)=>(b.is_popular?1:0) - (a.is_popular?1:0));

  if(!list.length){ grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1;">No services match your search just yet.</div>`; return; }

  grid.innerHTML = list.map(s=>`
    <div class="card">
      <div class="card-media">
        ${s.image_url ? `<img src="${esc(s.image_url)}" alt="${esc(s.name)}">` : `<span class="ph">Service photo</span>`}
        ${s.is_popular ? `<span class="badge">Popular</span>` : (s.is_featured ? `<span class="badge">Featured</span>` : "")}
      </div>
      <div class="card-body">
        <h3>${esc(s.name)}</h3>
        <p class="desc">${esc(s.description)}</p>
        <div class="card-meta">
          <span>${s.duration_minutes ? s.duration_minutes + " min" : ""}</span>
          <span class="price">${fmtPrice(s.price)}</span>
        </div>
        <button class="btn btn-ghost btn-sm btn-block" style="margin-top:6px;" onclick="MWOG.openService('${s.id}')">View &amp; Book</button>
      </div>
    </div>
  `).join("");
}
document.getElementById("svcSearch")?.addEventListener("input", renderServices);
document.getElementById("svcSort")?.addEventListener("change", renderServices);

function openService(id){
  const s = SERVICES.find(x=>x.id===id); if(!s) return;
  const cName = categoryName(s.category_id);
  const related = SERVICES.filter(x=>x.category_id===s.category_id && x.id!==s.id).slice(0,3);
  document.getElementById("svcModalBody").innerHTML = `
    <div class="card-media" style="border-radius:6px; margin-bottom:16px;">
      ${s.image_url ? `<img src="${esc(s.image_url)}" alt="${esc(s.name)}" style="border-radius:6px;">` : `<span class="ph">Service photo</span>`}
    </div>
    <div class="eyebrow">${esc(cName)}</div>
    <h3 class="h-md" style="margin-top:6px;">${esc(s.name)}</h3>
    <p style="margin-top:10px; color:var(--text-soft);">${esc(s.description)}</p>
    <div style="display:flex; gap:20px; margin-top:14px; font-size:.86rem;">
      <div><strong>Duration:</strong> ${s.duration_minutes ? s.duration_minutes + " min" : "—"}</div>
      <div><strong>Starting at:</strong> ${fmtPrice(s.price)}</div>
    </div>
    ${related.length ? `<div style="margin-top:18px;"><h4 style="font-size:.95rem;">Related services</h4>
      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
        ${related.map(r=>`<button class="chip" onclick="MWOG.openService('${r.id}')">${esc(r.name)}</button>`).join("")}
      </div></div>` : ""}
    <a href="#book" class="btn btn-gold btn-block" style="margin-top:20px;" onclick="MWOG.closeService(); document.getElementById('bkService').value='${s.id}';">Book This Service</a>
  `;
  document.getElementById("svcOverlay").classList.add("show");
}
function closeService(){ document.getElementById("svcOverlay").classList.remove("show"); }
document.getElementById("svcModalClose")?.addEventListener("click", closeService);
document.getElementById("svcOverlay")?.addEventListener("click", e=>{ if(e.target.id==="svcOverlay") closeService(); });

function renderBookingServiceOptions(){
  const sel = document.getElementById("bkService");
  sel.innerHTML = `<option value="">Choose a service</option>` + SERVICES.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join("");
