/* ---------------------------------------------------------------------
   Gallery
--------------------------------------------------------------------- */
let activeGalCat = "ALL";
function renderGalleryFilters(){
  const cats = ["ALL", ...new Set(GALLERY.map(g=>g.category).filter(Boolean))];
  document.getElementById("galFilters").innerHTML = cats.map(c=>`<button class="chip ${c===activeGalCat?'active':''}" data-c="${esc(c)}">${esc(c)}</button>`).join("");
  document.querySelectorAll("#galFilters .chip").forEach(b=> b.addEventListener("click", ()=>{ activeGalCat=b.dataset.c; renderGalleryFilters(); renderGallery(); }));
}
function renderGallery(){
  const wrap = document.getElementById("galGrid");
  const empty = document.getElementById("galEmpty");
  const list = GALLERY.filter(g=> activeGalCat==="ALL" || g.category===activeGalCat);
  if(!list.length){ wrap.innerHTML=""; empty.classList.remove("hidden"); return; }
  empty.classList.add("hidden");
  wrap.innerHTML = list.map(g=>{
    if(g.gallery_type === "before_after" && g.before_image_url){
      return `<div class="gal-item" style="display:flex;">
        <img src="${esc(g.before_image_url)}" style="width:50%;" onclick="MWOG.openLightbox('${esc(g.before_image_url)}')">
        <img src="${esc(g.image_url)}" style="width:50%;" onclick="MWOG.openLightbox('${esc(g.image_url)}')">
        <span class="gal-tag" style="left:auto; right:8px;">Before → After</span>
      </div>`;
    }
    return `<div class="gal-item" onclick="MWOG.openLightbox('${esc(g.image_url)}')">
      <img src="${esc(g.image_url)}" alt="${esc(g.title||'')}">
      ${g.category ? `<span class="gal-tag">${esc(g.category)}</span>` : ""}
    </div>`;
  }).join("");
}
function openLightbox(src){ document.getElementById("lightboxImg").src = src; document.getElementById("lightbox").classList.add("show"); }
document.getElementById("lightboxClose")?.addEventListener("click", ()=> document.getElementById("lightbox").classList.remove("show"));
document.getElementById("lightbox")?.addEventListener("click", e=>{ if(e.target.id==="lightbox") document.getElementById("lightbox").classList.remove("show"); });

