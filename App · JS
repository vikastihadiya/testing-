/* ---------------------------------------------------------------------
   Forms — real inserts into Supabase
--------------------------------------------------------------------- */
document.getElementById("bookingForm")?.addEventListener("submit", async function(e){
  e.preventDefault();
  const submitBtn = this.querySelector("[type=submit]");
  const serviceId = document.getElementById("bkService").value;
  const svc = SERVICES.find(s=>s.id===serviceId);
  const payload = {
    customer_name: document.getElementById("bkName").value,
    phone: document.getElementById("bkPhone").value,
    service_id: serviceId || null,
    preferred_date: document.getElementById("bkDate").value || null,
    preferred_time: document.getElementById("bkTime").value || null,
    source: "Website"
  };
  submitBtn.disabled = true; submitBtn.textContent = "Sending...";
  const { error } = await supabase.from("appointments").insert(payload);
  submitBtn.disabled = false; submitBtn.textContent = "Request Appointment";
  if(error){
    alert("Sorry, we couldn't send your request. Please try WhatsApp or call us directly.");
    console.error(error);
    return;
  }
  const msg = `Hello Manju's The World of Glamour, I would like to book an appointment.\nService: ${svc ? svc.name : ""}\nPreferred Date: ${payload.preferred_date || ""}\nPreferred Time: ${payload.preferred_time || ""}\nName: ${payload.customer_name}`;
  document.getElementById("bkWaLink").href = waLink(msg);
  document.getElementById("bkConfirm").classList.add("show");
  submitBtn.style.display = "none";
});

document.getElementById("bridalForm")?.addEventListener("submit", async function(e){
  e.preventDefault();
  const submitBtn = this.querySelector("[type=submit]");
  const payload = {
    bride_name: document.getElementById("brName").value,
    phone: document.getElementById("brPhone").value,
    wedding_date: document.getElementById("brDate").value || null,
    function_type: document.getElementById("brFunction").value,
    venue: document.getElementById("brVenue").value,
    number_of_functions: document.getElementById("brFnCount").value ? parseInt(document.getElementById("brFnCount").value) : null,
    makeup_style: document.getElementById("brStyle").value,
    budget_range: document.getElementById("brBudget").value,
    additional_requirements: document.getElementById("brNotes").value
  };
  submitBtn.disabled = true; submitBtn.textContent = "Sending...";
  const { error } = await supabase.from("bridal_enquiries").insert(payload);
  submitBtn.disabled = false; submitBtn.textContent = "Send Bridal Enquiry";
  if(error){
    alert("Sorry, we couldn't send your enquiry. Please try WhatsApp or call us directly.");
    console.error(error);
    return;
  }
  const msg = `Hello Manju's The World of Glamour, I'd like to enquire about bridal makeup.\nBride Name: ${payload.bride_name}\nWedding Date: ${payload.wedding_date || ""}\nFunction: ${payload.function_type}\nVenue: ${payload.venue}`;
  document.getElementById("brWaLink").href = waLink(msg);
  document.getElementById("brConfirm").classList.add("show");
  submitBtn.style.display = "none";
});

/* ---------------------------------------------------------------------
   Boot
--------------------------------------------------------------------- */
window.MWOG = { openService, closeService, openLightbox, toggleFaq };

async function boot(){
  await loadAll();
  renderSettings();
  renderServiceFilters(); renderServices(); renderBookingServiceOptions();
  renderBridalPackages();
  renderGalleryFilters(); renderGallery();
  renderTeam(); renderOffers(); renderReviews(); renderFaq();
  document.getElementById("yearNow").textContent = new Date().getFullYear();
}
boot();
