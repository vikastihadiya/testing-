    <div class="team-card">
      <div class="team-photo">${t.photo_url ? `<img src="${esc(t.photo_url)}" alt="${esc(t.name)}">` : `<span class="ph">${esc((t.name||"?").charAt(0))}</span>`}</div>
      <h4>${esc(t.name)}</h4>
      <div class="role">${esc(t.role||"")}</div>
      <div class="exp">${esc(t.specialty||"")}${t.experience ? " · "+esc(t.experience) : ""}</div>
    </div>
  `).join("");
}

/* ---------------------------------------------------------------------
   Offers
--------------------------------------------------------------------- */
function renderOffers(){
  const grid = document.getElementById("offerGrid");
  const empty = document.getElementById("offerEmpty");
  if(!OFFERS.length){ grid.innerHTML=""; empty.classList.remove("hidden"); return; }
  empty.classList.add("hidden");
  grid.innerHTML = OFFERS.map(o=>{
    const discount = (o.original_price && o.offer_price) ? Math.round((1-(o.offer_price/o.original_price))*100)+"% OFF" : "";
    return `
    <div class="offer-card">
      <div class="offer-top">
        <div>${esc(o.name)}</div>
        ${discount ? `<div class="disc">${discount}</div>`:""}
      </div>
      <div class="offer-body">
        <p style="font-size:.85rem; color:var(--text-soft);">${esc(o.description||"")}</p>
        <div class="offer-price">
          ${o.original_price != null ? `<del>₹${esc(o.original_price)}</del>`:""}
          <ins>${o.offer_price != null ? "₹"+esc(o.offer_price) : "Ask for pricing"}</ins>
        </div>
        ${o.valid_until ? `<div style="font-size:.76rem; color:var(--text-soft);">Valid until ${esc(o.valid_until)}</div>`:""}
        <a href="#book" class="btn btn-gold btn-sm btn-block">Book Now</a>
      </div>
    </div>`;
  }).join("");
}

