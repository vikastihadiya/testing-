import { supabase } from "./supabase-client.js";

/* ---------------------------------------------------------------------
   Helpers
--------------------------------------------------------------------- */
function esc(str){ return (str ?? "").toString().replace(/[&<>"']/g, s=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[s])); }
function fmtPrice(p){ return (p !== null && p !== undefined && p !== "") ? `₹${p} onwards` : "Ask for pricing"; }
function todayISO(){ return new Date().toISOString().slice(0,10); }

let SETTINGS = {};      // setting_key -> setting_value
let CATEGORIES = [];    // [{id,name,slug,display_order}]
let SERVICES = [];      // raw rows from `services`
let GALLERY = [];
let TEAM = [];
let TESTIMONIALS = [];
let FAQS = [];
let OFFERS = [];
let BRIDAL_PACKAGES = [];

function categoryName(id){
  const c = CATEGORIES.find(c=>c.id===id);
  return c ? c.name : "";
}

function waNumber(){ return (SETTINGS.whatsapp || "").replace(/[^0-9]/g,""); }
function waLink(msg){
  const num = waNumber();
  const base = num ? `https://wa.me/${num}` : `https://wa.me/`;
  return `${base}?text=${encodeURIComponent(msg)}`;
}

/* ---------------------------------------------------------------------
   Loader
--------------------------------------------------------------------- */
window.addEventListener("load", ()=>{
  setTimeout(()=>{ const l=document.getElementById("loader"); if(l) l.classList.add("hide"); }, 500);
});

/* ---------------------------------------------------------------------
   Nav (mobile menu)
--------------------------------------------------------------------- */
document.getElementById("hamburgerBtn")?.addEventListener("click", ()=> document.getElementById("mobileMenu").classList.add("open"));
document.getElementById("closeMenuBtn")?.addEventListener("click", ()=> document.getElementById("mobileMenu").classList.remove("open"));
document.querySelectorAll(".mnav").forEach(a=> a.addEventListener("click", ()=> document.getElementById("mobileMenu").classList.remove("open")));

/* ---------------------------------------------------------------------
   Data loading — every query below matches supabase-schema.sql exactly.
   If a query ever 400s, the FIRST thing to check is the column/table
   name here against that file, not the RLS policies.
--------------------------------------------------------------------- */
async function loadAll(){
  const [settingsRes, catRes, svcRes, pkgRes, offRes, galRes, teamRes, testRes, faqRes] = await Promise.all([
    supabase.from("settings").select("setting_key, setting_value"),
    supabase.from("categories").select("id, name, slug, display_order").order("display_order"),
    supabase.from("services").select("id, name, category_id, description, price, duration_minutes, image_url, is_popular, is_featured, is_active").eq("is_active", true),
    supabase.from("bridal_packages").select("id, name, price, includes, is_active").eq("is_active", true),
    supabase.from("offers").select("id, name, description, original_price, offer_price, valid_until, is_active").eq("is_active", true),
    supabase.from("gallery").select("id, gallery_type, category, title, image_url, before_image_url, is_featured, display_order").order("display_order"),
    supabase.from("team_members").select("id, name, role, specialty, experience, photo_url, is_active").eq("is_active", true).order("display_order"),
    supabase.from("testimonials").select("id, customer_name, testimonial, service_name, rating, is_approved").eq("is_approved", true),
    supabase.from("faqs").select("id, question, answer, display_order").order("display_order")
  ]);

  [settingsRes, catRes, svcRes, pkgRes, offRes, galRes, teamRes, testRes, faqRes].forEach(r=>{
    if(r.error) console.error("Supabase load error:", r.error.message);
  });

  SETTINGS = {};
  (settingsRes.data || []).forEach(row => SETTINGS[row.setting_key] = row.setting_value);

  CATEGORIES = catRes.data || [];
  SERVICES = svcRes.data || [];
  BRIDAL_PACKAGES = pkgRes.data || [];
  const today = todayISO();
  OFFERS = (offRes.data || []).filter(o => !o.valid_until || o.valid_until >= today);
  GALLERY = galRes.data || [];
  TEAM = teamRes.data || [];
  TESTIMONIALS = testRes.data || [];
  FAQS = faqRes.data || [];
}

