  const beforeWrap = document.getElementById("g_before_wrap");
  const imgLabel = document.getElementById("g_img_label");
  typeSel.addEventListener("change", ()=>{
    const isBA = typeSel.value === "before_after";
    beforeWrap.classList.toggle("hidden", !isBA);
    imgLabel.textContent = isBA ? '"After" image' : "Image";
  });

  document.getElementById("galForm").addEventListener("submit", async (e)=>{
    e.preventDefault();
    try{
      const image_url = await uploadImage(fileFrom("g_img"), "gallery");
      const isBA = typeSel.value === "before_after";
      const before_image_url = isBA ? await uploadImage(fileFrom("g_before_img"), "gallery") : null;
      const { error } = await supabase.from("gallery").insert({
        gallery_type: typeSel.value,
        category: document.getElementById("g_cat").value,
        title: document.getElementById("g_title").value,
        image_url, before_image_url
      });
      if(error) throw error;
      goToModule("gallery");
    }catch(err){ alert("Upload failed: " + err.message); }
  });
  moduleContent.querySelectorAll("[data-del]").forEach(b=> b.addEventListener("click", async ()=>{
    if(!confirm("Delete this image?")) return;
    const { error } = await supabase.from("gallery").delete().eq("id", b.dataset.del);
    if(error) return alert(error.message);
    goToModule("gallery");
  }));
}

