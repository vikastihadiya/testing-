import { supabase } from "./supabase-client.js";

/* ---------------------------------------------------------------------
   Helpers
--------------------------------------------------------------------- */
function esc(str){ return (str ?? "").toString().replace(/[&<>"']/g, s=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[s])); }
function todayISO(){ return new Date().toISOString().slice(0,10); }

async function uploadImage(file, folder){
  if(!file) return null;
  const cleanName = file.name.replace(/[^a-zA-Z0-9.\-_]/g, "_");
  const path = `${folder}/${Date.now()}_${cleanName}`;
  const { error } = await supabase.storage.from("media").upload(path, file, { upsert: false });
  if(error) throw error;
  const { data } = supabase.storage.from("media").getPublicUrl(path);
  return data.publicUrl;
}
function fileFrom(inputId){ return document.getElementById(inputId).files[0] || null; }

/* ---------------------------------------------------------------------
   Auth — single source of truth for "am I logged in"
--------------------------------------------------------------------- */
const loginSection = document.getElementById("loginSection");
const adminPanel = document.getElementById("adminPanel");
const moduleContent = document.getElementById("moduleContent");

function showLogin(){
  loginSection.style.display = "block";
  adminPanel.style.display = "none";
}
function showAdmin(){
  loginSection.style.display = "none";
  adminPanel.style.display = "block";
  renderTabs();
  goToModule(currentModule);
}

document.getElementById("loginForm").addEventListener("submit", async (e)=>{
  e.preventDefault();
  const email = document.getElementById("adEmail").value;
  const password = document.getElementById("adPass").value;
  const errEl = document.getElementById("loginErr");
  errEl.style.display = "none";
  const { error } = await supabase.auth.signInWithPassword({ email, password });
  if(error){
    errEl.textContent = error.message;
    errEl.style.display = "block";
    return;
  }
  showAdmin();
});

document.getElementById("logoutBtn").addEventListener("click", async ()=>{
  await supabase.auth.signOut();
  showLogin();
});

async function initAuth(){
  const { data } = await supabase.auth.getSession();
  if(data.session) showAdmin(); else showLogin();
}
supabase.auth.onAuthStateChange((_event, session)=>{
  if(session) showAdmin(); else showLogin();
});
initAuth();

/* ---------------------------------------------------------------------
   Tabs — each module is fully isolated: a failure in one module shows
   an inline error in #moduleContent, it never breaks the others.
--------------------------------------------------------------------- */
const MODULES = [
  { id: "dashboard",     label: "Dashboard",         render: renderDashboard },
  { id: "appointments",  label: "Appointments",      render: renderAppointments },
  { id: "bridalenq",     label: "Bridal Enquiries",  render: renderBridalEnquiries },
  { id: "categories",    label: "Categories",        render: renderCategories },
  { id: "services",      label: "Services",          render: renderServices },
  { id: "bridalpkg",     label: "Bridal Packages",   render: renderBridalPackages },
  { id: "offers",        label: "Offers",            render: renderOffers },
  { id: "gallery",       label: "Gallery",           render: renderGallery },
  { id: "team",          label: "Team",              render: renderTeam },
  { id: "testimonials",  label: "Testimonials",      render: renderTestimonials },
  { id: "faqs",          label: "FAQs",              render: renderFaqs },
  { id: "settings",      label: "Settings",          render: renderSettings }
];
let currentModule = "dashboard";

function renderTabs(){
  const html = MODULES.map(m => `<button data-m="${m.id}" class="${m.id===currentModule?'active':''}">${m.label}</button>`).join("");
  document.getElementById("moduleArea").innerHTML = html;
  document.getElementById("moduleAreaMobile").innerHTML = html;
  document.querySelectorAll("#moduleArea button, #moduleAreaMobile button").forEach(b=>{
    b.addEventListener("click", ()=> goToModule(b.dataset.m));
  });
}
async function goToModule(id){
  currentModule = id;
  renderTabs();
  moduleContent.innerHTML = `<p style="color:var(--text-soft);">Loading…</p>`;
  const mod = MODULES.find(m=>m.id===id);
  try{
    await mod.render();
  }catch(err){
    console.error(`[${id}] module error:`, err);
    moduleContent.innerHTML = `<div class="empty-state">This section couldn't load: ${esc(err.message || String(err))}<br><br>
      <button class="tiny-btn" onclick="location.reload()">Reload</button></div>`;
  }
}

/* =======================================================================
   DASHBOARD — each count is fetched independently so one bad query
   can't blank out the whole dashboard.
======================================================================= */
async function renderDashboard(){
  moduleContent.innerHTML = `<h2 class="h-md">Dashboard</h2><div class="admin-cards" id="dashCards" style="margin-top:20px;"></div>
    <p style="color:var(--text-soft); font-size:.86rem;">This panel talks directly to your Supabase project. Every visitor sees the same live data — no per-device storage involved.</p>`;
  const cardsEl = document.getElementById("dashCards");
  const today = todayISO();

  const cards = [
    { label: "Today's Appointments", query: () => supabase.from("appointments").select("id", { count: "exact", head: true }).eq("preferred_date", today) },
    { label: "New Enquiries", query: async () => {
        const a = await supabase.from("appointments").select("id", { count: "exact", head: true }).eq("status", "New");
        const b = await supabase.from("bridal_enquiries").select("id", { count: "exact", head: true }).eq("status", "New");
        if(a.error) throw a.error; if(b.error) throw b.error;
        return { count: (a.count||0) + (b.count||0) };
      } },
    { label: "Active Offers", query: () => supabase.from("offers").select("id", { count: "exact", head: true }).eq("is_active", true) },
    { label: "Total Services", query: () => supabase.from("services").select("id", { count: "exact", head: true }).eq("is_active", true) }
  ];

  cardsEl.innerHTML = cards.map(()=>`<div class="admin-stat"><div class="num">…</div><div class="lbl"></div></div>`).join("");
  const cardEls = cardsEl.querySelectorAll(".admin-stat");

  cards.forEach(async (c, i)=>{
    cardEls[i].querySelector(".lbl").textContent = c.label;
    try{
      const res = await c.query();
      if(res.error) throw res.error;
      cardEls[i].querySelector(".num").textContent = res.count ?? 0;
    }catch(e){
      cardEls[i].querySelector(".num").textContent = "—";
      cardEls[i].title = e.message;
    }
  });
}

