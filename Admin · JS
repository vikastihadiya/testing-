/* =======================================================================
   SETTINGS  (key/value table — exact columns: setting_key, setting_value)
======================================================================= */
async function renderSettings(){
  const { data, error } = await supabase.from("settings").select("setting_key, setting_value");
  if(error) throw error;
  const s = {};
  data.forEach(row => s[row.setting_key] = row.setting_value);
  let hours = [];
  try{ hours = JSON.parse(s.opening_hours || "[]"); }catch(e){ hours = []; }

  moduleContent.innerHTML = `
    <h2 class="h-md">Website Settings</h2>
    <form class="admin-form" id="setForm">
      <div class="row2">
        <div class="field"><label>Salon phone</label><input type="tel" id="st_phone" value="${esc(s.phone)}"></div>
        <div class="field"><label>WhatsApp number (country code + digits only)</label><input type="text" id="st_wa" value="${esc(s.whatsapp)}" placeholder="e.g. 919876543210"></div>
      </div>
      <div class="row2">
        <div class="field"><label>Email</label><input type="email" id="st_email" value="${esc(s.email)}"></div>
        <div class="field"><label>Instagram URL</label><input type="url" id="st_insta" value="${esc(s.instagram_url)}"></div>
      </div>
      <div class="field"><label>Address</label><input type="text" id="st_addr" value="${esc(s.address)}"></div>
      <div class="row2">
        <div class="field"><label>Google Maps link</label><input type="url" id="st_maps" value="${esc(s.maps_url)}"></div>
        <div class="field"><label>Google Review link</label><input type="url" id="st_greview" value="${esc(s.google_review_url)}"></div>
      </div>
      <div class="row2">
        <div class="field"><label>Verified Google rating (optional)</label><input type="text" id="st_rating" value="${esc(s.rating)}" placeholder="e.g. 4.8"></div>
        <div class="field"><label>Verified review count (optional)</label><input type="text" id="st_reviewcount" value="${esc(s.review_count)}" placeholder="e.g. 320+"></div>
      </div>
      <div><button class="btn btn-gold btn-sm" type="submit">Save Settings</button></div>
    </form>

    <h3 class="h-md" style="margin-top:30px;">Opening Hours</h3>
    <form class="admin-form" id="hrsForm">
      <div class="row2">
        <div class="field"><label>Days</label><input type="text" id="h_days" placeholder="e.g. Monday – Saturday"></div>
        <div class="field"><label>Time</label><input type="text" id="h_time" placeholder="e.g. 10:00 AM – 8:00 PM"></div>
      </div>
      <div><button class="btn btn-ghost btn-sm" type="submit">Add Row</button></div>
    </form>
    <div class="admin-table-wrap"><table class="admin-table"><tbody>${hours.map((h,i)=>`<tr><td>${esc(h.day)}</td><td>${esc(h.time)}</td><td><button class="tiny-btn danger" data-hdel="${i}">Delete</button></td></tr>`).join("")}</tbody></table></div>

    <h3 class="h-md" style="margin-top:30px;">Change Your Admin Password</h3>
    <form class="admin-form" id="passForm">
      <div class="field"><label>New password</label><input type="password" id="new_pass" minlength="6" required></div>
      <div><button class="btn btn-ghost btn-sm" type="submit">Update Password</button></div>
    </form>
  `;

  document.getElementById("setForm").addEventListener("submit", async (e)=>{
    e.preventDefault();
    const updates = {
      phone: document.getElementById("st_phone").value,
      whatsapp: document.getElementById("st_wa").value,
      email: document.getElementById("st_email").value,
      instagram_url: document.getElementById("st_insta").value,
      address: document.getElementById("st_addr").value,
      maps_url: document.getElementById("st_maps").value,
      google_review_url: document.getElementById("st_greview").value,
      rating: document.getElementById("st_rating").value,
      review_count: document.getElementById("st_reviewcount").value
    };
    try{
      await Promise.all(Object.entries(updates).map(([key, value]) =>
        supabase.from("settings").update({ setting_value: value }).eq("setting_key", key).then(r=>{ if(r.error) throw r.error; })
      ));
      alert("Settings saved.");
    }catch(err){ alert("Couldn't save settings: " + err.message); }
  });

  document.getElementById("hrsForm").addEventListener("submit", async (e)=>{
    e.preventDefault();
    const day = document.getElementById("h_days").value, time = document.getElementById("h_time").value;
    if(!day || !time) return;
    hours.push({ day, time });
    const { error } = await supabase.from("settings").update({ setting_value: JSON.stringify(hours) }).eq("setting_key", "opening_hours");
    if(error) return alert(error.message);
    goToModule("settings");
  });
  moduleContent.querySelectorAll("[data-hdel]").forEach(b=> b.addEventListener("click", async ()=>{
    hours.splice(parseInt(b.dataset.hdel), 1);
    const { error } = await supabase.from("settings").update({ setting_value: JSON.stringify(hours) }).eq("setting_key", "opening_hours");
    if(error) return alert(error.message);
    goToModule("settings");
  }));

  document.getElementById("passForm").addEventListener("submit", async (e)=>{
    e.preventDefault();
    const { error } = await supabase.auth.updateUser({ password: document.getElementById("new_pass").value });
    if(error) return alert(error.message);
    alert("Password updated. Use it next time you log in.");
    e.target.reset();
  });
}
