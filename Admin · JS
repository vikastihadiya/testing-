/* =======================================================================
   SERVICES
======================================================================= */
async function renderServices(){
  const [svcRes, catRes] = await Promise.all([
    supabase.from("services").select("id, name, category_id, description, price, duration_minutes, image_url, is_popular, is_featured, is_active").order("created_at", { ascending: false }),
    supabase.from("categories").select("id, name").order("display_order")
  ]);
  if(svcRes.error) throw svcRes.error;
  if(catRes.error) throw catRes.error;
  const services = svcRes.data, categories = catRes.data;
  const catName = id => (categories.find(c=>c.id===id) || {}).name || "—";

  moduleContent.innerHTML = `
    <h2 class="h-md">Services</h2>
    <form class="admin-form" id="svcForm">
      <div class="row3">
        <div class="field"><label>Service name</label><input type="text" id="f_name" required></div>
        <div class="field"><label>Category</label><select id="f_cat">${categories.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join("")}</select></div>
        <div class="field"><label>Duration (minutes)</label><input type="number" id="f_dur"></div>
      </div>
      <div class="field"><label>Description</label><textarea id="f_desc" rows="2"></textarea></div>
      <div class="row3">
        <div class="field"><label>Starting price (₹, optional)</label><input type="number" id="f_price"></div>
        <div class="field"><label>Photo</label><input type="file" accept="image/*" id="f_img"></div>
        <div class="field">
          <label style="display:block;font-size:.82rem;font-weight:400;text-transform:none;"><input type="checkbox" id="f_pop"> Popular</label>
          <label style="display:block;font-size:.82rem;font-weight:400;text-transform:none;"><input type="checkbox" id="f_feat"> Featured</label>
          <label style="display:block;font-size:.82rem;font-weight:400;text-transform:none;"><input type="checkbox" id="f_active" checked> Active (visible on site)</label>
        </div>
      </div>
      <input type="hidden" id="f_id">
      <div><button class="btn btn-gold btn-sm" type="submit" id="svcSubmitBtn">Add Service</button> <button class="btn btn-ghost btn-sm hidden" type="button" id="svcCancelEdit">Cancel Edit</button></div>
    </form>
    <div class="admin-table-wrap">
    <table class="admin-table"><thead><tr><th>Photo</th><th>Name</th><th>Category</th><th>Price</th><th>Active</th><th></th></tr></thead>
    <tbody>${services.map(s=>`
      <tr>
        <td>${s.image_url?`<img class="thumb-sm" src="${esc(s.image_url)}">`:"—"}</td>
        <td>${esc(s.name)}</td><td>${esc(catName(s.category_id))}</td><td>${s.price!=null?"₹"+s.price:"—"}</td><td>${s.is_active?"Yes":"No"}</td>
        <td><button class="tiny-btn" data-edit="${s.id}">Edit</button><button class="tiny-btn danger" data-del="${s.id}">Delete</button></td>
      </tr>`).join("")}</tbody></table></div>
  `;

  const form = document.getElementById("svcForm");
  form.addEventListener("submit", async (e)=>{
    e.preventDefault();
    const submitBtn = document.getElementById("svcSubmitBtn");
    submitBtn.disabled = true;
    try{
      const id = document.getElementById("f_id").value;
      const file = fileFrom("f_img");
      const image_url = file ? await uploadImage(file, "services") : undefined;
      const payload = {
        name: document.getElementById("f_name").value,
        category_id: document.getElementById("f_cat").value || null,
        duration_minutes: document.getElementById("f_dur").value ? parseInt(document.getElementById("f_dur").value) : null,
        description: document.getElementById("f_desc").value,
        price: document.getElementById("f_price").value ? parseFloat(document.getElementById("f_price").value) : null,
        is_popular: document.getElementById("f_pop").checked,
        is_featured: document.getElementById("f_feat").checked,
        is_active: document.getElementById("f_active").checked
      };
      if(image_url) payload.image_url = image_url;

      const { error } = id
        ? await supabase.from("services").update(payload).eq("id", id)
        : await supabase.from("services").insert(payload);
      if(error) throw error;
      goToModule("services");
    }catch(err){
      alert("Couldn't save service: " + err.message);
      submitBtn.disabled = false;
    }
  });

  moduleContent.querySelectorAll("[data-edit]").forEach(b=> b.addEventListener("click", ()=>{
    const s = services.find(x=>x.id===b.dataset.edit);
    document.getElementById("f_id").value = s.id;
    document.getElementById("f_name").value = s.name;
    document.getElementById("f_cat").value = s.category_id || "";
    document.getElementById("f_dur").value = s.duration_minutes || "";
    document.getElementById("f_desc").value = s.description || "";
    document.getElementById("f_price").value = s.price ?? "";
    document.getElementById("f_pop").checked = !!s.is_popular;
    document.getElementById("f_feat").checked = !!s.is_featured;
    document.getElementById("f_active").checked = !!s.is_active;
    document.getElementById("svcSubmitBtn").textContent = "Save Changes";
    document.getElementById("svcCancelEdit").classList.remove("hidden");
    moduleContent.scrollIntoView({ behavior: "smooth" });
  }));
  document.getElementById("svcCancelEdit").addEventListener("click", ()=> goToModule("services"));
  moduleContent.querySelectorAll("[data-del]").forEach(b=> b.addEventListener("click", async ()=>{
    if(!confirm("Delete this service?")) return;
    const { error } = await supabase.from("services").delete().eq("id", b.dataset.del);
    if(error) return alert(error.message);
    goToModule("services");
  }));
}

