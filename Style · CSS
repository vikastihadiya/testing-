:root{
  --ivory:#FBF7EF; --champagne:#E9DBBF; --beige:#F1E7D6; --charcoal:#221D18;
  --gold:#A3792F; --gold-soft:#C9A968; --ember:#7C4B37; --white:#FFFFFF;
  --line:rgba(34,29,24,0.12);
  --bg:var(--ivory); --text:var(--charcoal); --text-soft:#5C534A;
  --surface:var(--white); --surface-alt:var(--beige);
  --safe-t:env(safe-area-inset-top,0px); --safe-b:env(safe-area-inset-bottom,0px);
  --font-d:'Fraunces',Georgia,serif; --font-b:'Inter',-apple-system,Helvetica,Arial,sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#171310; --text:#F2E9D8; --text-soft:#C9BCA8;
    --surface:#221D18; --surface-alt:#231D17; --line:rgba(242,233,216,0.14);
    color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --bg:#171310; --text:#F2E9D8; --text-soft:#C9BCA8;
  --surface:#221D18; --surface-alt:#231D17; --line:rgba(242,233,216,0.14);
  color-scheme: dark;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth; scroll-padding-top: calc(76px + var(--safe-t));}
@media (prefers-reduced-motion: reduce){ html{scroll-behavior:auto;} *{animation-duration:.001ms !important; transition-duration:.001ms !important;} }
body{
  margin:0; background:var(--bg); color:var(--text); font-family:var(--font-b);
  font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased;
  padding-top:calc(var(--safe-t)); padding-bottom:calc(var(--safe-b));
  overflow-x:hidden;
}
img{max-width:100%; display:block;}
a{color:inherit;}
h1,h2,h3,h4{font-family:var(--font-d); font-weight:500; margin:0; letter-spacing:.01em;}
p{margin:0;}
.container{max-width:1180px; margin:0 auto; padding:0 20px;}
@media(min-width:768px){.container{padding:0 40px;}}
.section{padding:64px 0;}
@media(min-width:900px){.section{padding:96px 0;}}
.section-alt{background:var(--surface-alt);}
.eyebrow{font-size:.72rem; letter-spacing:.14em; color:var(--gold); font-weight:600; text-transform:uppercase;}
.h-xl{font-size:clamp(2.1rem,5.5vw,3.6rem); line-height:1.08;}
.h-lg{font-size:clamp(1.7rem,4vw,2.5rem); line-height:1.14;}
.h-md{font-size:clamp(1.25rem,2.6vw,1.6rem);}
.lede{color:var(--text-soft); font-size:1.05rem; max-width:52ch;}
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  border:1px solid var(--charcoal); background:var(--charcoal); color:var(--ivory);
  padding:14px 26px; font-family:var(--font-b); font-size:.85rem; font-weight:600;
  letter-spacing:.04em; cursor:pointer; text-decoration:none; border-radius:2px;
  transition:transform .18s ease, box-shadow .18s ease; -webkit-tap-highlight-color:transparent;
}
.btn:hover{transform:translateY(-2px); box-shadow:0 12px 24px rgba(34,29,24,0.22);}
.btn:active{transform:translateY(0);}
.btn-ghost{background:transparent; color:var(--text); border-color:var(--line);}
.btn-gold{background:var(--gold); border-color:var(--gold); color:var(--white);}
.btn-wa{background:#3E7A5C; border-color:#3E7A5C; color:#fff;}
.btn-sm{padding:9px 16px; font-size:.75rem;}
.btn-block{width:100%;}
.link-underline{border-bottom:1px solid var(--gold); padding-bottom:2px; font-weight:600; font-size:.9rem;}

/* NAV */
header#topnav{
  position:sticky; top:0; z-index:60; background:color-mix(in srgb, var(--bg) 92%, transparent);
  backdrop-filter:blur(10px); border-bottom:1px solid var(--line);
  padding-top:var(--safe-t);
}
.nav-row{display:flex; align-items:center; justify-content:space-between; height:70px;}
.brand{font-family:var(--font-d); line-height:1.05;}
.brand .l1{font-size:1.15rem; letter-spacing:.06em; font-weight:600;}
.brand .l2{font-size:.58rem; letter-spacing:.22em; color:var(--gold); text-transform:uppercase; display:block;}
nav.main-links{display:none; gap:28px; align-items:center;}
nav.main-links a{font-size:.86rem; text-decoration:none; color:var(--text-soft); transition:color .15s;}
nav.main-links a:hover{color:var(--gold);}
@media(min-width:1020px){nav.main-links{display:flex;}}
.nav-actions{display:flex; align-items:center; gap:12px;}
.hamburger{display:flex; background:none; border:0; font-size:1.4rem; cursor:pointer; color:var(--text); padding:6px;}
@media(min-width:1020px){.hamburger{display:none;}}
.mobile-menu{position:fixed; inset:0; background:var(--bg); z-index:80; padding:20px; transform:translateX(100%); transition:transform .28s ease; overflow-y:auto;}
.mobile-menu.open{transform:translateX(0);}
.mobile-menu-top{display:flex; justify-content:flex-end;}
.mobile-menu a{display:block; font-family:var(--font-d); font-size:1.5rem; padding:14px 0; border-bottom:1px solid var(--line); text-decoration:none; color:var(--text);}

/* HERO */
.hero{
  position:relative; min-height:88vh; display:flex; align-items:flex-end;
  background:
    radial-gradient(ellipse at 20% 10%, rgba(163,121,47,0.28), transparent 55%),
    radial-gradient(ellipse at 85% 85%, rgba(124,75,55,0.35), transparent 55%),
    linear-gradient(160deg,#221D18 0%, #372D22 55%, #221D18 100%);
  color:#F6EFE1; overflow:hidden;
}
.hero::before{
  content:""; position:absolute; inset:0; opacity:.5;
  background-image: repeating-linear-gradient(115deg, rgba(255,255,255,0.035) 0 2px, transparent 2px 90px);
}
.hero-inner{position:relative; z-index:2; padding:120px 0 64px;}
.hero .eyebrow{color:var(--gold-soft);}
.hero h1{font-size:clamp(2.4rem,7vw,4.4rem); line-height:1.03; margin-top:10px; max-width:14ch;}
.hero .tagline{font-family:var(--font-d); font-style:italic; font-size:clamp(1.05rem,2.4vw,1.35rem); color:#E7D9BE; margin-top:16px; max-width:34ch;}
.hero .support{color:#CFC2AC; margin-top:14px; max-width:48ch; font-size:1rem;}
.hero-ctas{display:flex; flex-wrap:wrap; gap:14px; margin-top:32px;}
.hero .btn-ghost{border-color:rgba(246,239,225,0.4); color:#F6EFE1;}
.trust-strip{display:flex; flex-wrap:wrap; gap:26px; margin-top:44px; padding-top:24px; border-top:1px solid rgba(246,239,225,0.18);}
.trust-item{font-size:.82rem; color:#D8CBB2;}
.trust-item strong{display:block; font-family:var(--font-d); font-size:1.1rem; color:#fff;}

/* BOOKING WIDGET */
.booking-wrap{margin-top:-56px; position:relative; z-index:10;}
.booking-card{
  background:var(--surface); border:1px solid var(--line); border-radius:6px;
  box-shadow:0 30px 60px rgba(34,29,24,0.18); padding:28px 22px;
}
@media(min-width:860px){.booking-card{padding:38px 44px;}}
.booking-card h2{font-size:1.05rem; letter-spacing:.06em; text-transform:uppercase;}
.form-grid{display:grid; grid-template-columns:1fr; gap:14px; margin-top:20px;}
@media(min-width:700px){.form-grid{grid-template-columns:repeat(2,1fr);}}
@media(min-width:1020px){.form-grid.cols-5{grid-template-columns:repeat(5,1fr);}}
.field label{display:block; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; color:var(--text-soft); margin-bottom:6px;}
.field input, .field select, .field textarea{
  width:100%; border:1px solid var(--line); background:var(--bg); color:var(--text);
  padding:12px 12px; font-family:var(--font-b); font-size:.92rem; border-radius:3px;
}
.field input:focus, .field select:focus, .field textarea:focus{outline:2px solid var(--gold); outline-offset:1px;}
.form-note{font-size:.76rem; color:var(--text-soft); margin-top:14px;}
.confirm-box{margin-top:18px; padding:16px; border:1px solid var(--gold); background:rgba(163,121,47,0.08); border-radius:4px; display:none;}
.confirm-box.show{display:block;}

/* STATS */
.stats-row{display:grid; grid-template-columns:repeat(2,1fr); gap:28px; text-align:center;}
@media(min-width:700px){.stats-row{grid-template-columns:repeat(4,1fr);}}
.stat-num{font-family:var(--font-d); font-size:clamp(1.6rem,3.4vw,2.2rem); color:var(--gold);}
.stat-label{font-size:.78rem; color:var(--text-soft); letter-spacing:.04em; margin-top:4px;}

/* ABOUT */
.about-grid{display:grid; gap:36px;}
@media(min-width:900px){.about-grid{grid-template-columns:1fr 1fr; align-items:center; gap:64px;}}
.art-panel{
  aspect-ratio:4/5; border-radius:6px; position:relative; overflow:hidden;
  background:
    radial-gradient(circle at 30% 20%, rgba(201,169,104,0.35), transparent 60%),
    linear-gradient(150deg, var(--surface-alt), var(--champagne));
  border:1px solid var(--line); display:flex; align-items:center; justify-content:center;
}
.art-panel .monogram{font-family:var(--font-d); font-size:5rem; color:rgba(34,29,24,0.15); font-style:italic;}
.art-panel .placeholder-tag{
  position:absolute; bottom:14px; left:14px; right:14px; font-size:.72rem; text-align:center;
  color:var(--text-soft); background:color-mix(in srgb, var(--surface) 75%, transparent); padding:8px; border-radius:3px; border:1px dashed var(--line);
}
.about-list{margin-top:22px; display:grid; gap:10px;}
.about-list li{display:flex; gap:10px; font-size:.95rem; align-items:flex-start;}
.about-list li::before{content:"—"; color:var(--gold);}

/* SERVICES */
.filter-row{display:flex; gap:10px; overflow-x:auto; padding-bottom:6px; margin:26px 0 28px; scrollbar-width:none;}
.filter-row::-webkit-scrollbar{display:none;}
.chip{flex:0 0 auto; padding:9px 18px; border-radius:20px; border:1px solid var(--line); background:var(--surface); font-size:.82rem; cursor:pointer; white-space:nowrap;}
.chip.active{background:var(--charcoal); color:var(--ivory); border-color:var(--charcoal);}
.search-sort{display:flex; flex-wrap:wrap; gap:12px; margin-bottom:8px;}
.search-sort input, .search-sort select{border:1px solid var(--line); background:var(--surface); padding:11px 14px; border-radius:20px; font-size:.85rem; font-family:var(--font-b); color:var(--text);}
.search-sort input{flex:1 1 220px;}
.svc-grid{display:grid; grid-template-columns:1fr; gap:20px; margin-top:22px;}
@media(min-width:640px){.svc-grid{grid-template-columns:repeat(2,1fr);}}
@media(min-width:1020px){.svc-grid{grid-template-columns:repeat(3,1fr);}}
.card{background:var(--surface); border:1px solid var(--line); border-radius:6px; overflow:hidden; display:flex; flex-direction:column; transition:box-shadow .2s ease, transform .2s ease;}
.card:hover{box-shadow:0 18px 40px rgba(34,29,24,0.12); transform:translateY(-3px);}
.card-media{aspect-ratio:4/3; background:linear-gradient(135deg,var(--champagne),var(--surface-alt)); position:relative; display:flex; align-items:center; justify-content:center;}
.card-media img{width:100%; height:100%; object-fit:cover; position:absolute; inset:0;}
.card-media .ph{font-family:var(--font-d); font-style:italic; color:rgba(34,29,24,0.25); font-size:1.4rem;}
.badge{position:absolute; top:10px; left:10px; background:var(--gold); color:#fff; font-size:.65rem; letter-spacing:.05em; text-transform:uppercase; padding:4px 9px; border-radius:12px;}
.card-body{padding:18px; display:flex; flex-direction:column; gap:8px; flex:1;}
.card-body h3{font-size:1.08rem;}
.card-body .desc{color:var(--text-soft); font-size:.88rem; flex:1;}
.card-meta{display:flex; justify-content:space-between; align-items:center; font-size:.82rem; color:var(--text-soft); border-top:1px solid var(--line); padding-top:10px; margin-top:4px;}
.card-meta .price{color:var(--text); font-weight:600; font-family:var(--font-d); font-size:1rem;}
.empty-state{text-align:center; padding:48px 20px; border:1px dashed var(--line); border-radius:6px; color:var(--text-soft);}

/* MODAL */
.overlay{position:fixed; inset:0; background:rgba(20,16,12,0.6); z-index:100; display:none; align-items:flex-end; justify-content:center;}
.overlay.show{display:flex;}
@media(min-width:760px){.overlay{align-items:center;}}
.modal{background:var(--bg); width:100%; max-width:640px; max-height:92vh; overflow-y:auto; border-radius:12px 12px 0 0; padding:26px 22px calc(26px + var(--safe-b));}
@media(min-width:760px){.modal{border-radius:10px; padding:36px;}}
.modal-close{float:right; background:none; border:0; font-size:1.4rem; cursor:pointer; color:var(--text-soft);}

/* BRIDAL */
.bridal-hero{background:linear-gradient(160deg,#2C231C,#221D18); color:#F6EFE1; border-radius:8px; padding:44px 26px; text-align:center;}
@media(min-width:900px){.bridal-hero{padding:64px;}}
.bridal-hero h2{font-size:clamp(1.9rem,4.6vw,3rem);}
.pkg-grid{display:grid; grid-template-columns:1fr; gap:20px; margin-top:32px;}
@media(min-width:720px){.pkg-grid{grid-template-columns:repeat(2,1fr);}}
@media(min-width:1080px){.pkg-grid{grid-template-columns:repeat(3,1fr);}}
.pkg-card{background:var(--surface); border:1px solid var(--gold); border-radius:6px; padding:26px; text-align:left; display:flex; flex-direction:column; gap:12px;}
.pkg-card .price{font-family:var(--font-d); font-size:1.7rem;}
.pkg-card ul{margin:0; padding-left:18px; font-size:.88rem; color:var(--text-soft); display:grid; gap:5px;}

/* GALLERY */
.gal-grid{columns:2 220px; column-gap:14px; margin-top:22px;}
@media(min-width:900px){.gal-grid{columns:4 220px;}}
.gal-item{break-inside:avoid; margin-bottom:14px; border-radius:6px; overflow:hidden; position:relative; cursor:pointer; background:var(--surface-alt); border:1px solid var(--line);}
.gal-item img{width:100%; display:block;}
.gal-item .ph{aspect-ratio:3/4; display:flex; align-items:center; justify-content:center; font-family:var(--font-d); font-style:italic; color:rgba(34,29,24,0.25);}
.gal-tag{position:absolute; bottom:8px; left:8px; background:rgba(0,0,0,0.55); color:#fff; font-size:.68rem; padding:3px 8px; border-radius:10px;}
.lightbox{position:fixed; inset:0; background:rgba(10,8,6,0.92); z-index:110; display:none; align-items:center; justify-content:center; padding:20px;}
.lightbox.show{display:flex;}
.lightbox img{max-height:88vh; max-width:100%; border-radius:4px;}
.lightbox-close{position:absolute; top:20px; right:20px; background:none; border:0; color:#fff; font-size:1.8rem; cursor:pointer;}

/* TEAM */
.team-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:18px; margin-top:24px;}
@media(min-width:720px){.team-grid{grid-template-columns:repeat(4,1fr);}}
.team-card{text-align:center;}
.team-photo{aspect-ratio:1; border-radius:50%; background:linear-gradient(135deg,var(--champagne),var(--surface-alt)); margin:0 auto 12px; display:flex; align-items:center; justify-content:center; overflow:hidden; border:1px solid var(--line);}
.team-photo img{width:100%; height:100%; object-fit:cover;}
.team-photo .ph{font-family:var(--font-d); font-style:italic; font-size:1.6rem; color:rgba(34,29,24,0.3);}
.team-card h4{font-size:1rem;}
.team-card .role{color:var(--gold); font-size:.78rem; margin-top:2px;}
.team-card .exp{font-size:.78rem; color:var(--text-soft); margin-top:6px;}

/* WHY */
.why-grid{display:grid; grid-template-columns:1fr; gap:22px; margin-top:24px;}
@media(min-width:700px){.why-grid{grid-template-columns:repeat(2,1fr);}}
@media(min-width:1080px){.why-grid{grid-template-columns:repeat(4,1fr);}}
.why-item{padding:22px; border:1px solid var(--line); border-radius:6px; background:var(--surface);}
.why-item .mark{color:var(--gold); font-size:1.3rem;}
.why-item h4{margin-top:10px; font-size:1rem;}
.why-item p{font-size:.85rem; color:var(--text-soft); margin-top:6px;}

/* OFFERS */
.offer-grid{display:grid; grid-template-columns:1fr; gap:20px; margin-top:24px;}
@media(min-width:700px){.offer-grid{grid-template-columns:repeat(2,1fr);}}
@media(min-width:1080px){.offer-grid{grid-template-columns:repeat(3,1fr);}}
.offer-card{border:1px solid var(--line); border-radius:6px; background:var(--surface); overflow:hidden;}
.offer-top{background:var(--charcoal); color:var(--ivory); padding:16px 18px;}
.offer-top .disc{color:var(--gold-soft); font-size:.78rem; font-weight:600;}
.offer-body{padding:16px 18px; display:grid; gap:10px;}
.offer-price del{color:var(--text-soft); margin-right:8px; font-size:.85rem;}
.offer-price ins{text-decoration:none; font-family:var(--font-d); font-size:1.3rem;}

/* REVIEWS */
.rev-grid{display:grid; grid-template-columns:1fr; gap:18px; margin-top:24px;}
@media(min-width:720px){.rev-grid{grid-template-columns:repeat(3,1fr);}}
.rev-card{background:var(--surface); border:1px solid var(--line); border-radius:6px; padding:20px;}
.stars{color:var(--gold); letter-spacing:2px;}
.rev-card .name{font-weight:600; margin-top:10px;}
.rev-card .svc{font-size:.76rem; color:var(--text-soft);}

/* FAQ */
.faq-item{border-bottom:1px solid var(--line);}
.faq-q{width:100%; text-align:left; background:none; border:0; padding:18px 0; font-family:var(--font-d); font-size:1.05rem; display:flex; justify-content:space-between; align-items:center; cursor:pointer; color:var(--text);}
.faq-a{max-height:0; overflow:hidden; transition:max-height .25s ease;}
.faq-a p{padding-bottom:18px; color:var(--text-soft); font-size:.92rem; max-width:70ch;}
.faq-item.open .faq-a{max-height:400px;}
.faq-item.open .faq-q .plus{transform:rotate(45deg);}
.faq-q .plus{transition:transform .2s; color:var(--gold); font-size:1.3rem;}

/* CONTACT */
.contact-grid{display:grid; gap:28px;}
@media(min-width:900px){.contact-grid{grid-template-columns:1fr 1fr;}}
.map-frame{aspect-ratio:4/3; border-radius:6px; overflow:hidden; border:1px solid var(--line);}
.contact-links{display:grid; gap:10px; margin-top:18px;}
.contact-links a{display:flex; align-items:center; gap:10px; text-decoration:none; padding:12px 14px; border:1px solid var(--line); border-radius:6px; font-size:.9rem;}
.hours-table{width:100%; border-collapse:collapse; margin-top:10px; font-size:.88rem;}
.hours-table td{padding:6px 0; border-bottom:1px solid var(--line);}

/* FOOTER */
footer{background:var(--charcoal); color:#D8CBB2; padding:56px 0 calc(28px + var(--safe-b));}
.foot-grid{display:grid; grid-template-columns:1fr; gap:32px;}
@media(min-width:800px){.foot-grid{grid-template-columns:2fr 1fr 1fr 1fr;}}
footer h5{color:#F6EFE1; font-size:.82rem; letter-spacing:.06em; text-transform:uppercase; margin-bottom:14px;}
footer a{display:block; color:#C7B99C; text-decoration:none; font-size:.87rem; margin-bottom:8px;}
.foot-bottom{border-top:1px solid rgba(216,203,178,0.15); margin-top:40px; padding-top:20px; font-size:.78rem; display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; color:#A8987C;}

/* STICKY MOBILE BAR */
.mobile-bar{
  position:fixed; left:0; right:0; bottom:0; z-index:70; background:var(--surface); border-top:1px solid var(--line);
  display:grid; grid-template-columns:1fr 1fr 1.3fr; padding-bottom:var(--safe-b);
  box-shadow:0 -8px 24px rgba(0,0,0,0.08);
}
@media(min-width:1020px){.mobile-bar{display:none;}}
.mobile-bar a, .mobile-bar button{
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
  padding:10px 4px; font-size:.68rem; font-family:var(--font-b); text-decoration:none; color:var(--text); border:0; background:none; cursor:pointer;
}
.mobile-bar .mid{border-left:1px solid var(--line); border-right:1px solid var(--line);}
.mobile-bar .book-cta{background:var(--gold); color:#fff; font-weight:600;}
.wa-float{
  position:fixed; right:18px; bottom:calc(84px + var(--safe-b)); z-index:65; width:54px; height:54px; border-radius:50%;
  background:#3E7A5C; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none;
  box-shadow:0 10px 24px rgba(0,0,0,0.25); font-size:1.5rem;
}
@media(min-width:1020px){.wa-float{bottom:26px;}}

/* LOADER */
#loader{position:fixed; inset:0; background:var(--charcoal); color:var(--ivory); z-index:200; display:flex; align-items:center; justify-content:center; flex-direction:column; transition:opacity .4s ease, visibility .4s ease;}
#loader .brand{text-align:center;}
#loader .l1{font-size:1.5rem;}
#loader .l2{font-size:.68rem;}
#loader .bar{width:120px; height:1px; background:rgba(246,239,225,0.25); margin-top:22px; position:relative; overflow:hidden;}
#loader .bar::after{content:""; position:absolute; left:-40%; top:0; bottom:0; width:40%; background:var(--gold); animation:load 1.1s ease-in-out infinite;}
@keyframes load{0%{left:-40%;}100%{left:100%;}}
#loader.hide{opacity:0; visibility:hidden;}

/* ADMIN */
#admin{display:none; background:var(--bg); min-height:100vh;}
#admin.show{display:block;}
.admin-topbar{background:var(--charcoal); color:#fff; padding:16px 20px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:5;}
.admin-shell{display:flex; min-height:calc(100vh - 58px);}
.admin-tabs{width:190px; flex:0 0 190px; border-right:1px solid var(--line); padding:16px 0; display:none;}
@media(min-width:800px){.admin-tabs{display:block;}}
.admin-tabs button{display:block; width:100%; text-align:left; background:none; border:0; padding:12px 20px; font-size:.86rem; cursor:pointer; color:var(--text-soft);}
.admin-tabs button.active{color:var(--gold); font-weight:600; border-right:2px solid var(--gold);}
.admin-tabs-mobile{display:flex; overflow-x:auto; gap:8px; padding:12px 16px; border-bottom:1px solid var(--line);}
@media(min-width:800px){.admin-tabs-mobile{display:none;}}
.admin-tabs-mobile button{flex:0 0 auto; padding:8px 14px; border-radius:16px; border:1px solid var(--line); background:var(--surface); font-size:.78rem;}
.admin-tabs-mobile button.active{background:var(--charcoal); color:var(--ivory);}
.admin-content{flex:1; padding:22px 18px 80px;}
@media(min-width:800px){.admin-content{padding:32px 40px;}}
.admin-cards{display:grid; grid-template-columns:repeat(2,1fr); gap:14px; margin-bottom:28px;}
@media(min-width:700px){.admin-cards{grid-template-columns:repeat(4,1fr);}}
.admin-stat{background:var(--surface); border:1px solid var(--line); border-radius:6px; padding:16px;}
.admin-stat .num{font-family:var(--font-d); font-size:1.7rem;}
.admin-stat .lbl{font-size:.76rem; color:var(--text-soft);}
.admin-table{width:100%; border-collapse:collapse; background:var(--surface); border:1px solid var(--line); border-radius:6px; overflow:hidden; font-size:.86rem;}
.admin-table th, .admin-table td{padding:10px 12px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top;}
.admin-table th{background:var(--surface-alt); font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; color:var(--text-soft);}
.admin-table-wrap{overflow-x:auto;}
.admin-form{background:var(--surface); border:1px solid var(--line); border-radius:6px; padding:20px; margin-bottom:24px; display:grid; gap:12px;}
.admin-form .row2{display:grid; gap:12px;}
@media(min-width:640px){.admin-form .row2{grid-template-columns:1fr 1fr;}}
.admin-form .row3{display:grid; gap:12px;}
@media(min-width:640px){.admin-form .row3{grid-template-columns:1fr 1fr 1fr;}}
.tiny-btn{padding:5px 10px; font-size:.72rem; border-radius:3px; border:1px solid var(--line); background:var(--surface); cursor:pointer; margin-right:6px;}
.tiny-btn.danger{border-color:#B5493A; color:#B5493A;}
.thumb-sm{width:44px; height:44px; object-fit:cover; border-radius:4px; border:1px solid var(--line);}
.login-wrap{max-width:380px; margin:80px auto; padding:0 20px;}
.status-pill{padding:3px 9px; border-radius:10px; font-size:.7rem; font-weight:600;}
.status-New{background:#E8D9A6; color:#5A4A12;}
.status-Confirmed{background:#BFE3C7; color:#1F5A2E;}
.status-Completed{background:#C9DDF0; color:#1F4A6B;}
.status-Cancelled{background:#EFC7C2; color:#7A2418;}
.status-No-show{background:#E2E2E2; color:#555;}
.hidden{display:none !important;}
.vis-toggle{margin-top:6px;}
::selection{background:var(--gold-soft); color:#221D18;}
