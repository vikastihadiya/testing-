-- ---- bridal_enquiries: public INSERT only, admin full access ----
create policy "bridal_enquiries_public_insert" on bridal_enquiries
  for insert to anon, authenticated with check (true);
create policy "bridal_enquiries_admin_select" on bridal_enquiries
