      <a href="#services">Services</a><a href="#bridal">Bridal</a><a href="#work">Gallery</a><a href="#book">Book Appointment</a><a href="#contact">Contact</a>
    </div>
    <div>
      <h5>Connect</h5>
      <a href="#" id="footInsta">Instagram</a><a href="#" id="footWa">WhatsApp</a><a href="#" id="footMaps">Google Maps</a>
    </div>
    <div>
      <h5>Legal</h5>
      <a href="#">Privacy Policy</a><a href="#">Terms of Service</a>
    </div>
  </div>
  <div class="container foot-bottom">
    <span>© <span id="yearNow"></span> Manju's The World of Glamour. All rights reserved.</span>
