  <div class="container foot-grid">
    <div>
      <div class="brand" style="color:#F6EFE1;"><span class="l1">MANJU'S</span><span class="l2">The World of Glamour</span></div>
      <p style="margin-top:14px; font-size:.85rem; max-width:36ch; color:#B7A98A;">A premium women's beauty parlour, salon and bridal studio in Sector 3, Rohini, Delhi.</p>
    </div>
    <div>
